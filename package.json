{
  "name": "light",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "LIGHT \u2014 a look engine that sits between Resolume and your lighting network. Art-Net/sACN out, MIDI in, OSC sync, 2D/3D previz.",
  "scripts": {
    "dev": "concurrently -k -n engine,ui -c blue,magenta \"node --watch engine/index.ts\" \"vite ui --port 5173\"",
    "dev:rust": "concurrently -k -n engine,ui -c red,magenta \"cargo run -p light-core --bin light-engine\" \"vite ui --port 5173\"",
    "build": "vite build ui",
    "start": "node engine/index.ts",
    "start:rust": "npm run build && cargo run --release -p light-core --bin light-engine",
    "app:dev": "tauri dev",
    "app:build": "bash scripts/build-app.sh",
    "previz": "cargo run --release -p light-previz",
    "test": "node engine/test/smoke.ts",
    "test:parity": "node engine/test/diff.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "app:build:native": "LIGHT_TARGET=aarch64-apple-darwin bash scripts/build-app.sh"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.179.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.179.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
