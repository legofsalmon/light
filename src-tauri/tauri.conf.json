{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LIGHT",
  "version": "1.2.1",
  "identifier": "com.colmhewson.light",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "vite ui --port 5173",
    "beforeBuildCommand": "vite build ui"
  },
  "app": {
    "windows": [
      {
        "title": "LIGHT",
        "width": 1500,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../ui/dist": "ui-dist"
    },
    "macOS": {
      "entitlements": "light.entitlements"
    }
  }
}
