{
  "$description": "LIGHT design tokens — the codified current look, not a redesign. Source of truth until the Figma library exists; after that Figma variables are the source and this file is regenerated from them. Format follows the W3C Design Tokens draft ($value/$type) so it imports into Figma variable tooling unchanged. Every value here was measured from ui/src/theme.css and the components on 2026-09-05; see docs/design/system.md for the component inventory and the inconsistencies this set resolves.",

  "primitive": {
    "$description": "Raw palette. Nothing in the app should reference these directly — use semantic.",
    "grey": {
      "0":   { "$type": "color", "$value": "#000000" },
      "950": { "$type": "color", "$value": "#101012", "$description": "previz ground; folds #101013 (2D canvas) and #0d0d10 (3D scene)" },
      "900": { "$type": "color", "$value": "#141415", "$description": "app ground; folds #141414 in index.html" },
      "850": { "$type": "color", "$value": "#1c1c1e" },
      "800": { "$type": "color", "$value": "#212124" },
      "750": { "$type": "color", "$value": "#2a2a2e" },
      "700": { "$type": "color", "$value": "#2e2e33" },
      "650": { "$type": "color", "$value": "#323238" },
      "600": { "$type": "color", "$value": "#3c3c44" },
      "500": { "$type": "color", "$value": "#4a4a52" },
      "400": { "$type": "color", "$value": "#5c5c66" },
      "300": { "$type": "color", "$value": "#8c8c96" },
      "100": { "$type": "color", "$value": "#d2d2d8" },
      "white": { "$type": "color", "$value": "#ffffff" }
    },
    "cyan":   { "500": { "$type": "color", "$value": "#39c2ff" } },
    "green":  { "500": { "$type": "color", "$value": "#3fd97a" } },
    "amber": {
      "400": { "$type": "color", "$value": "#ffb347", "$description": "warn" },
      "500": { "$type": "color", "$value": "#f0a63e", "$description": "ride / soft override — resolves the undefined --amber; folds #ffb020 (.warnchip, meter override)" }
    },
    "orange": { "500": { "$type": "color", "$value": "#ff8a3d", "$description": "the FLASH mark, single use" } },
    "red": {
      "400": { "$type": "color", "$value": "#ff5252" },
      "450": { "$type": "color", "$value": "#ff2d2d" },
      "500": { "$type": "color", "$value": "#ff4d4d", "$description": "hot" },
      "600": { "$type": "color", "$value": "#d84040", "$description": "blackout idle" },
      "800": { "$type": "color", "$value": "#7a2424" },
      "900": { "$type": "color", "$value": "#4a1f1f" },
      "950": { "$type": "color", "$value": "#2a0d0d" }
    },
    "rose": {
      "200": { "$type": "color", "$value": "#ffb5b5" },
      "300": { "$type": "color", "$value": "#ff9d9d" },
      "600": { "$type": "color", "$value": "#9a4a4a" },
      "700": { "$type": "color", "$value": "#6e3a3a" }
    },
    "swatch": {
      "$description": "the pad-thumbnail vocabulary from ui/src/lookColors.ts",
      "rainbow-1": { "$type": "color", "$value": "#ff3b30" },
      "rainbow-2": { "$type": "color", "$value": "#ffcc00" },
      "rainbow-3": { "$type": "color", "$value": "#34c759" },
      "rainbow-4": { "$type": "color", "$value": "#32ade6" },
      "rainbow-5": { "$type": "color", "$value": "#5856d6" },
      "rainbow-6": { "$type": "color", "$value": "#ff2d88" },
      "neutral":   { "$type": "color", "$value": "#3a3a40" },
      "white":     { "$type": "color", "$value": "#f5f5f0" },
      "strobe":    { "$type": "color", "$value": "#e8e8ee" },
      "dimmer":    { "$type": "color", "$value": "#9a9aa4" }
    },
    "scene": {
      "$description": "canvas and WebGL palettes, kept apart so the console palette stays small",
      "3d-bg":     { "$type": "color", "$value": "#0d0d10" },
      "3d-body":   { "$type": "color", "$value": "#2c2c33" },
      "3d-body-2": { "$type": "color", "$value": "#232328" },
      "3d-grid":   { "$type": "color", "$value": "#2c2c34" },
      "3d-grid-2": { "$type": "color", "$value": "#1b1b20" },
      "3d-floor":  { "$type": "color", "$value": "#131316" },
      "2d-bg":     { "$type": "color", "$value": "#101013" },
      "2d-outline":{ "$type": "color", "$value": "#4a4a52" },
      "meter-bg":  { "$type": "color", "$value": "#1a1a1c" },
      "meter-span":{ "$type": "color", "$value": "#2b2b31" },
      "meter-span-2": { "$type": "color", "$value": "#232329" }
    }
  },

  "semantic": {
    "$description": "What the app actually references. One mode: dark. The app is a white-on-dark console for low-light rooms and does not ship a light theme.",
    "bg": {
      "app":          { "$type": "color", "$value": "{primitive.grey.900}" },
      "panel":        { "$type": "color", "$value": "{primitive.grey.850}", "$description": "chrome surfaces: top bar, bottom panel, panes, modal" },
      "inset":        { "$type": "color", "$value": "{primitive.grey.800}", "$description": "fields, faders, pads, headers" },
      "raised":       { "$type": "color", "$value": "{primitive.grey.750}", "$description": "buttons at rest, library rows" },
      "raised-hover": { "$type": "color", "$value": "{primitive.grey.650}" },
      "scene":        { "$type": "color", "$value": "{primitive.grey.950}" },
      "seam":         { "$type": "color", "$value": "{primitive.grey.0}", "$description": "the 1px gaps between shell regions" },
      "wash-empty":   { "$type": "color", "$value": "#ffffff03" },
      "wash-selected":{ "$type": "color", "$value": "#ffffff0f" },
      "wash-hover":   { "$type": "color", "$value": "#ffffff17" }
    },
    "border": {
      "default":  { "$type": "color", "$value": "{primitive.grey.700}" },
      "strong":   { "$type": "color", "$value": "{primitive.grey.600}", "$description": "controls" },
      "selected": { "$type": "color", "$value": "{primitive.grey.300}" },
      "focus":    { "$type": "color", "$value": "{primitive.cyan.500}" }
    },
    "text": {
      "primary":   { "$type": "color", "$value": "{primitive.grey.100}" },
      "secondary": { "$type": "color", "$value": "{primitive.grey.300}", "$description": "≈5.1:1 on panel — the floor for content" },
      "tertiary":  { "$type": "color", "$value": "{primitive.grey.400}", "$description": "≈2.6:1 — decoration only, never content (theme.css:987)" },
      "inverse":   { "$type": "color", "$value": "{primitive.grey.0}" },
      "on-accent": { "$type": "color", "$value": "{primitive.grey.white}" }
    },
    "accent": {
      "default": { "$type": "color", "$value": "{primitive.cyan.500}" },
      "soft":    { "$type": "color", "$value": "#39c2ff29", "$description": "fill behind every on-state (16%)" },
      "fill-hi": { "$type": "color", "$value": "#39c2ff52", "$description": "fader fill top (32%)" },
      "fill-lo": { "$type": "color", "$value": "#39c2ff2e", "$description": "fader fill bottom (18%)" },
      "marquee": { "$type": "color", "$value": "#39c2ff14" },
      "marquee-edge": { "$type": "color", "$value": "#39c2ffb3" }
    },
    "status": {
      "ok":        { "$type": "color", "$value": "{primitive.green.500}" },
      "warn":      { "$type": "color", "$value": "{primitive.amber.400}" },
      "bad":       { "$type": "color", "$value": "{primitive.red.500}" },
      "flash":     { "$type": "color", "$value": "{primitive.orange.500}" },
      "ride":      { "$type": "color", "$value": "{primitive.amber.500}" },
      "ride-fill": { "$type": "color", "$value": "#f0a63e2e" }
    },
    "danger": {
      "$description": "soft-red controls: clear layer, delete, all stop, muted chip",
      "text":         { "$type": "color", "$value": "{primitive.rose.300}" },
      "text-hover":   { "$type": "color", "$value": "{primitive.rose.200}" },
      "border":       { "$type": "color", "$value": "{primitive.rose.700}" },
      "border-hover": { "$type": "color", "$value": "{primitive.rose.600}" },
      "bg-hover":     { "$type": "color", "$value": "{primitive.red.900}" },
      "bg-deep":      { "$type": "color", "$value": "{primitive.red.950}" },
      "border-deep":  { "$type": "color", "$value": "{primitive.red.800}" }
    },
    "blackout": {
      "$description": "the one control allowed its own red",
      "text":         { "$type": "color", "$value": "{primitive.red.600}" },
      "border":       { "$type": "color", "$value": "{primitive.red.800}" },
      "fill":         { "$type": "color", "$value": "#a01e1e1a" },
      "armed-text":   { "$type": "color", "$value": "{primitive.red.400}" },
      "armed-border": { "$type": "color", "$value": "{primitive.red.450}" },
      "armed-fill":   { "$type": "color", "$value": "#ff2d2d47" },
      "armed-glow":   { "$type": "color", "$value": "#ff2d2d59" }
    },
    "overlay": {
      "veil":        { "$type": "color", "$value": "#0000008c" },
      "fader-dim-hi":{ "$type": "color", "$value": "#ffffff24" },
      "fader-dim-lo":{ "$type": "color", "$value": "#ffffff12" }
    }
  },

  "type": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "Helvetica Neue", "Arial", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SF Mono", "Menlo", "monospace"] }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium":  { "$type": "fontWeight", "$value": 500 },
      "bold":    { "$type": "fontWeight", "$value": 700 }
    },
    "line-height": {
      "tight":   { "$type": "number", "$value": 1.15, "$description": "pad names" },
      "control": { "$type": "number", "$value": 1.5 },
      "prose":   { "$type": "number", "$value": 1.6, "$description": "collapses the inline 1.45 / 1.7 / 1.9" }
    },
    "style": {
      "$description": "composite styles = size / tracking / case. 'label' is the workhorse: 95 uses.",
      "micro":    { "$type": "typography", "$value": { "fontSize": "8px",   "letterSpacing": "0.08em", "textCase": "upper" } },
      "tag":      { "$type": "typography", "$value": { "fontSize": "9px",   "letterSpacing": "0.06em", "textCase": "upper" } },
      "label":    { "$type": "typography", "$value": { "fontSize": "9.5px", "letterSpacing": "0.09em", "textCase": "upper" } },
      "tab":      { "$type": "typography", "$value": { "fontSize": "10px",  "letterSpacing": "0.12em", "textCase": "upper" } },
      "section":  { "$type": "typography", "$value": { "fontSize": "10px",  "letterSpacing": "0.14em", "textCase": "upper" } },
      "control":  { "$type": "typography", "$value": { "fontSize": "10.5px","letterSpacing": "0.07em", "textCase": "upper", "lineHeight": 1.5 } },
      "control-tracked": { "$type": "typography", "$value": { "fontSize": "10.5px", "letterSpacing": "0.10em", "textCase": "upper" } },
      "body-s":   { "$type": "typography", "$value": { "fontSize": "11px" } },
      "body":     { "$type": "typography", "$value": { "fontSize": "12px" } },
      "body-relaxed": { "$type": "typography", "$value": { "fontSize": "12px", "lineHeight": 1.5 } },
      "title":    { "$type": "typography", "$value": { "fontSize": "13px" } },
      "wordmark": { "$type": "typography", "$value": { "fontSize": "13px", "fontWeight": 700, "letterSpacing": "0.42em", "textCase": "upper" } },
      "splash":   { "$type": "typography", "$value": { "fontSize": "13px", "letterSpacing": "0.35em", "textCase": "upper" } },
      "num":      { "$type": "typography", "$value": { "fontFamily": "{type.family.mono}", "fontSize": "11px" } },
      "log":      { "$type": "typography", "$value": { "fontFamily": "{type.family.mono}", "fontSize": "10.5px" } },
      "bpm":      { "$type": "typography", "$value": { "fontFamily": "{type.family.mono}", "fontSize": "17px" } }
    }
  },

  "space": {
    "$description": "core = 2/4/6/8/12/16/24; 3 and 5 are pixel-tuned exceptions inside the pad grid",
    "1":  { "$type": "dimension", "$value": "1px" },
    "2":  { "$type": "dimension", "$value": "2px" },
    "3":  { "$type": "dimension", "$value": "3px" },
    "4":  { "$type": "dimension", "$value": "4px" },
    "5":  { "$type": "dimension", "$value": "5px" },
    "6":  { "$type": "dimension", "$value": "6px" },
    "8":  { "$type": "dimension", "$value": "8px" },
    "10": { "$type": "dimension", "$value": "10px" },
    "12": { "$type": "dimension", "$value": "12px" },
    "14": { "$type": "dimension", "$value": "14px" },
    "16": { "$type": "dimension", "$value": "16px" },
    "18": { "$type": "dimension", "$value": "18px" },
    "24": { "$type": "dimension", "$value": "24px" }
  },

  "radius": {
    "xs":   { "$type": "dimension", "$value": "2px" },
    "sm":   { "$type": "dimension", "$value": "3px", "$description": "the default — 13 rules" },
    "md":   { "$type": "dimension", "$value": "4px", "$description": "menus" },
    "lg":   { "$type": "dimension", "$value": "6px", "$description": "modal" },
    "pill": { "$type": "dimension", "$value": "50%" }
  },

  "size": {
    "topbar":      { "$type": "dimension", "$value": "46px" },
    "splitter":    { "$type": "dimension", "$value": "6px" },
    "strip":       { "$type": "dimension", "$value": "18px", "$description": "collapsed pane reveal strip" },
    "btn":         { "$type": "dimension", "$value": "26px" },
    "btn-sm":      { "$type": "dimension", "$value": "20px" },
    "input":       { "$type": "dimension", "$value": "25px" },
    "fader":       { "$type": "dimension", "$value": "22px" },
    "colhead":     { "$type": "dimension", "$value": "26px" },
    "pad-w":       { "$type": "dimension", "$value": "108px" },
    "pad-h":       { "$type": "dimension", "$value": "58px" },
    "pad-name":    { "$type": "dimension", "$value": "17px", "$description": "the select-without-firing strip" },
    "layerhead-w": { "$type": "dimension", "$value": "168px" },
    "addcol-w":    { "$type": "dimension", "$value": "30px" },
    "led":         { "$type": "dimension", "$value": "8px" },
    "statusdot":   { "$type": "dimension", "$value": "7px" },
    "enable":      { "$type": "dimension", "$value": "12px" },
    "swatch":      { "$type": "dimension", "$value": "16px" },
    "swatch-current": { "$type": "dimension", "$value": "20px" },
    "scrollbar":   { "$type": "dimension", "$value": "10px" },
    "modal-w":     { "$type": "dimension", "$value": "460px" },
    "modal-wide-w":{ "$type": "dimension", "$value": "680px" },
    "min-grid-w":  { "$type": "dimension", "$value": "290px", "$description": "layer head + one pad" },
    "min-library": { "$type": "dimension", "$value": "200px" },
    "min-editor":  { "$type": "dimension", "$value": "300px" },
    "touch-target":{ "$type": "dimension", "$value": "24px", "$description": "NOT met today by .btn.small, .enable, swatches, strips — the design system's first correction" }
  },

  "elevation": {
    "menu":  { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "8px",  "blur": "24px", "color": "#00000073" } },
    "modal": { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "18px", "blur": "50px", "color": "#0000008c" } },
    "glow-accent":   { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "0", "blur": "6px",  "color": "{primitive.cyan.500}" } },
    "glow-blackout": { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "0", "blur": "10px", "color": "#ff2d2d59" } }
  },

  "motion": {
    "fast":  { "$type": "duration", "$value": "120ms" },
    "base":  { "$type": "duration", "$value": "150ms" },
    "pulse-splash":   { "$type": "duration", "$value": "1200ms" },
    "pulse-identify": { "$type": "duration", "$value": "1400ms" },
    "pulse-offline":  { "$type": "duration", "$value": "1600ms" }
  }
}
